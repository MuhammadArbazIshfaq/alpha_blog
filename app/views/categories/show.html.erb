<h1 class="text-center mt-4">Category:<%= @category.name%></h1>

<% if logged_in? && current_user.admin? %>
<div class="text-center mb-3">
<%= link_to "Edit Category", edit_category_path(@category), class: "btn btn-primary mb-3" %>
</div>
<%end%>

<h3 class="text-center mt-4">Articles in this Category</h3>

<div class="apple_pagination mb-4">
    <div class="page_info">
      <%= page_entries_info @articles %>
    </div>
    <%= will_paginate @articles, :container => false %>
  </div>
<%= render 'articles/article'%>

  <div class="apple_pagination mt-4">
    <div class="page_info">
      <%= page_entries_info @articles %>
    </div>
    <%= will_paginate @articles, :container => false %>
  </div>
